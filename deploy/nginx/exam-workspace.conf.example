# Install into /etc/nginx/conf.d/exam-workspace.conf (included within http {}).
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
# Deliberately omit query strings, cookies and bodies from access logs.
log_format exam_safe '$remote_addr $request_method $uri $status $body_bytes_sent';
server {
    listen 80;
    server_name exam.example.edu;
    # If HTTP-01 ACME is used, add a separate /.well-known/acme-challenge/ root.
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name exam.example.edu;
    ssl_certificate /etc/ssl/exam/fullchain.pem;
    ssl_certificate_key /etc/ssl/exam/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/exam-access.log exam_safe;
    client_max_body_size 12m;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy 'camera=(self), fullscreen=(self), display-capture=(self), microphone=(), clipboard-read=(), clipboard-write=()' always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
        proxy_connect_timeout 5s;
    }
    location ~ ^/api/admin/(attempts/[^/]+/submission|exams/[^/]+/submissions)$ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
}
