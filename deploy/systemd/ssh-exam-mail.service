[Unit]
Description=SSH Exam local SMTP socket forwarding
After=smtpd.service
Requires=smtpd.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd /run/smtpd.sock
User=nobody
Group=65534
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
