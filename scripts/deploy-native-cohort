#!/usr/bin/env python3
"""Guarded, forward-only installation of a frozen four-binary native cohort.

Run only after the matched web controller has stopped the drained gateway.
This never cancels an attempt, changes configuration, restores data or restarts SSH.
"""
import argparse
import contextlib
import datetime
import fcntl
import hashlib
import io
import json
import os
from pathlib import Path
import re
import runpy
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import uuid

TARGETS = {"exam-agent": "/usr/local/sbin/exam-agent", "examctl": "/usr/local/sbin/examctl", "exam-login": "/usr/local/libexec/exam-login", "exam-info": "/usr/local/bin/exam-info"}
ROLES = ["exam-agent.service", "exam-deadline-watchdog.service", "exam-source-setup.service"]
STOP = ["exam-reconcile.timer", "exam-reconcile.service", "exam-source-setup.service", "exam-agent.service", "exam-deadline-watchdog.service"]
START = ["exam-deadline-watchdog.service", "exam-source-setup.service", "exam-agent.service", "exam-reconcile.timer"]
CONFIG = Path("/etc/exam-agent/agent.json")
CLI_CONFIG = Path("/etc/exam-agent/examctl.json")
RELAY = Path("/usr/local/libexec/exam-ssh-relay")
GUARD_SHA256 = "3a49907d8b99b6994f2646d1b5cf066d608c55c0398cd63417e7de0ef6f6ff56"
DIGEST = re.compile(r"^[a-f0-9]{64}$")
OWNER_UID = 0


class StartupPending(Exception):
    pass


def digest(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def private(path, directory=False):
    info = path.lstat()
    assert (stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode))
    assert info.st_uid == os.geteuid() and not info.st_mode & 0o077 and not path.is_symlink(), "Unsafe private release input"
    if not directory:
        assert info.st_nlink == 1 and info.st_size < 1024 * 1024, "Unsafe release metadata"
    return info


def read_json(path):
    private(path)
    return json.loads(path.read_bytes())


def atomic(path, data, mode=0o600):
    descriptor, temporary = tempfile.mkstemp(prefix=".native-install-", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as output:
            output.write(data)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.chown(temporary, os.geteuid(), os.getegid())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        Path(temporary).unlink(missing_ok=True)


def command(args, timeout=25):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    assert result.returncode == 0, "Command failed; preserve fenced state: " + args[0]
    return result.stdout


def unit(name):
    return dict(line.split("=", 1) for line in command(["/usr/bin/systemctl", "show", name, "-p", "MainPID", "-p", "ActiveState"]).splitlines())


def require_root():
    assert os.geteuid() == 0 and __debug__, "Root and enabled safety assertions required"


def roots(config):
    assert config["state"] == "/var/lib/exam-agent" and config["work"] == "/srv/exam-workspace/work"
    return Path(config["state"]), Path(config["work"])


class Native:
    def __init__(self, stage, fixture=False):
        assert stage.is_absolute() and not any(path.is_symlink() for path in (stage, *stage.parents)), "Use a real absolute private stage"
        self.stage, self.fixture = stage.resolve(), fixture
        private(self.stage, directory=True)
        self.release = read_json(self.stage / "release.json")
        self.update = self.release["native_update"]
        assert self.release["schema"] == 37
        uuid.UUID(self.update["nonce"])
        for side in ("before", "after"):
            values = self.update[side]["binary_sha256"]
            assert set(values) == set(TARGETS) and all(DIGEST.fullmatch(v) for v in values.values())
        assert self.update["after"]["worker_cli_sha256"] == self.update["after"]["binary_sha256"]["examctl"]
        assert self.update["guard_sha256"] == digest(self.stage / "native-guard.py")
        assert fixture or self.update["guard_sha256"] == GUARD_SHA256, "Unqualified production guard"
        self.config = json.loads(CONFIG.read_bytes())
        self.state, self.work = roots(self.config)
        self.identity = digest(self.stage / "release.json")
        status = self.stage / "native-status.json"
        self.record = read_json(status) if status.exists() else {"phase": "STAGED", "nonce": self.update["nonce"], "release_sha256": self.identity}
        assert self.record["nonce"] == self.update["nonce"] and self.record["release_sha256"] == self.identity
        for executable in ("/usr/bin/systemctl", "/usr/bin/tar"):
            assert os.access(executable, os.X_OK), "Required installed executable unavailable: " + executable
        self.inputs()

    def save(self, phase, **values):
        self.record.update(values, phase=phase, at=datetime.datetime.now(datetime.timezone.utc).isoformat())
        atomic(self.stage / "native-status.json", canonical(self.record) + b"\n")

    def inputs(self):
        for name, value in self.update["after"]["binary_sha256"].items():
            path = self.stage / "native" / name
            info = path.lstat()
            assert stat.S_ISREG(info.st_mode) and info.st_nlink == 1 and info.st_uid == os.geteuid() and not info.st_mode & 0o022
            assert 0 < info.st_size <= 128 * 1024 * 1024 and digest(path) == value, "Frozen candidate changed"

    def preserved(self):
        assert digest(CONFIG) == self.release["native_config_sha256"] and digest(CLI_CONFIG) == self.release["cli_config_sha256"], "Configuration changed"
        data = json.loads((self.state / "state.json").read_bytes())
        assert hashlib.sha256(canonical(data["attempts"])).hexdigest() == self.release["native_history_sha256"], "Attempt history changed"
        now = int(datetime.datetime.now().timestamp() * 1000)
        for attempt in data["attempts"].values():
            assert attempt["state"] in ("COMPLETED", "CANCELLED_BEFORE_START")
            assert not attempt.get("units") and not attempt.get("preparation_pending") and not attempt.get("timing_pending_since")
            assert max(attempt.get("deadline") or 0, attempt.get("original_deadline") or 0) <= now
            assert (attempt.get("policy_state") or "NORMAL") == "NORMAL" and not attempt.get("policy_error") and not attempt.get("access_error")
            if attempt["state"] == "COMPLETED":
                assert attempt.get("protected") and attempt.get("access_state") in ("RELEASED", "OVERRIDDEN")
        assert not data.get("capabilities") and not data.get("pane_instances") and all(v <= now for v in data.get("commands", {}).values())
        return data

    def binaries(self, side):
        expected = self.update[side]["binary_sha256"]
        for name, path in TARGETS.items():
            info = Path(path).lstat()
            assert stat.S_ISREG(info.st_mode) and info.st_uid == OWNER_UID and stat.S_IMODE(info.st_mode) == 0o755 and digest(path) == expected[name], "Installed cohort differs: " + name
        return expected

    def pids(self):
        values = {name: int(unit(name)["MainPID"]) for name in ROLES}
        values["exam-ssh-relay.service"] = 0 if self.fixture else int(unit("exam-ssh-relay.service")["MainPID"])
        return values

    def guard(self, after=False):
        if after:
            assert self.record["phase"] == "VERIFIED", "Verify the matched cohort before publishing its guard"
        self.preserved()
        side = "after" if after else "before"
        values = self.update[side]
        self.binaries(side)
        plan = self.stage / ("guard-after" if after else "guard-before")
        plan.mkdir(mode=0o700, exist_ok=True)
        private(plan, directory=True)
        proof = {**self.release, "agent_sha256": values["binary_sha256"]["exam-agent"], "old_cli_sha256": values["binary_sha256"]["examctl"], "cli_sha256": values["binary_sha256"]["examctl"], "worker_cli_sha256": values["worker_cli_sha256"], "service_pids": self.record["service_pids"] if after else values["service_pids"]}
        atomic(plan / "release.json", canonical(proof))
        atomic(plan / "native-guard.py", (self.stage / "native-guard.py").read_bytes())
        previous = sys.argv
        output = io.StringIO()
        try:
            sys.argv = [str(plan / "native-guard.py"), str(plan), "after-cli"]
            with contextlib.redirect_stdout(output):
                runpy.run_path(str(plan / "native-guard.py"), run_name="__main__")
        finally:
            sys.argv = previous
        result = json.loads(output.getvalue())
        assert result["guard"] == "PASS" and result["host"] == ("private-native-install-qualification" if self.fixture else "csc-sys")
        result.update(phase="after-native" if after else "before-native", nonce=self.update["nonce"], binary_sha256=values["binary_sha256"])
        if after:
            self.health()
            result.update(policy_supported=True, transition_receipt_sha256=digest(self.stage / "native-transition.json"))
        return result

    def stopped(self):
        self.preserved()
        for name in STOP:
            value = unit(name)
            assert value["ActiveState"] == "inactive" and int(value.get("MainPID", "0")) == 0, "Native writer remains: " + name
        assert not any(line.rstrip().endswith(self.config["socket"]) for line in Path("/proc/net/unix").read_text().splitlines()[1:]), "Native socket owner remains"

    def web_stopped(self):
        web = read_json(self.stage / "web-stop.json")
        assert web["nonce"] == self.update["nonce"] and web["phase"] == "WAITING_NATIVE", "Gateway stop proof absent"
        at = datetime.datetime.fromisoformat(web["at"])
        assert at.tzinfo is not None and -1 <= (datetime.datetime.now(datetime.timezone.utc) - at).total_seconds() <= 90, "Gateway stop proof is stale; obtain a fresh stopped inventory"
        assert web["web_state"] == self.release["fast_ui"]["state"] and DIGEST.fullmatch(web["web_status_sha256"])
        assert web["web_image_config_id"] == self.release["old_image_config_id"] and web["web_stopped"] is True and web["web_fenced"] is True
        assert web["revision"] == self.release["revision"] and web["image_config_id"] == self.release["image_config_id"] and web["native_binary_sha256"] == self.update["after"]["binary_sha256"], "Gateway handoff belongs to another candidate"

    def stop(self):
        self.web_stopped()
        if self.record["phase"] == "STAGED":
            self.guard()
            self.save("STOPPING")
        assert self.record["phase"] in ("STOPPING", "STOPPED")
        for name in ROLES:
            assert int(unit(name)["MainPID"]) in (0, self.update["before"]["service_pids"][name]), "Unreviewed service replacement"
        self.binaries("before")
        command(["/usr/bin/systemctl", "stop", *STOP])
        self.stopped()
        self.save("STOPPED")

    def backup(self):
        self.web_stopped()
        assert self.record["phase"] in ("STOPPED", "BACKED_UP")
        self.stopped()
        if self.record["phase"] == "BACKED_UP":
            return self.check_backup()
        descriptor = os.open(self.state / "lock", os.O_RDWR | os.O_NOFOLLOW)
        try:
            info = os.fstat(descriptor)
            assert info.st_uid == os.geteuid() and stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            parent = self.stage / "backup"
            parent.mkdir(mode=0o700, exist_ok=True)
            private(parent, directory=True)
            paths = self.backup_paths()
            paths = sorted(set(paths), key=str)
            paths = [p for p in paths if not any(q in p.parents and q.is_dir() and not q.is_symlink() for q in paths)]
            assert all(p.exists() or p.is_symlink() for p in paths) and shutil.disk_usage(parent).free > 1024 * 1024 * 1024
            archive = parent / ("native-before-" + uuid.uuid4().hex + ".tar")
            command(["/usr/bin/tar", "--acls", "--xattrs", "--numeric-owner", "--sparse", "-cpf", str(archive), "-C", "/", *[str(p).lstrip("/") for p in paths]], timeout=60)
            with tarfile.open(archive) as stream:
                members = {m.name.rstrip("/") for m in stream}
            assert all(str(p).lstrip("/") in members for p in paths), "Incomplete native backup"
            self.preserved()
            os.chmod(archive, 0o600)
            self.save("BACKED_UP", backup=str(archive), backup_sha256=digest(archive), backup_bytes=archive.stat().st_size, files_sha256=self.files_identity())
        finally:
            os.close(descriptor)

    def backup_paths(self):
        paths = [self.state, self.work, CONFIG.parent, Path("/etc/ssh"), Path("/etc/pam.d"), Path("/etc/security"), Path("/etc/shells"), *map(Path, TARGETS.values()), *map(Path, ("/usr/local/sbin/exam-account-policy", "/usr/local/sbin/exam-check-isolation", "/usr/local/bin/exam-control", "/usr/local/sbin/exam-principals"))]
        for name in ("gateway_public_key", "callback_key", "handoff_ca"):
            if self.config.get(name):
                path = Path(self.config[name])
                paths.append(path)
                if Path(str(path) + ".pub").exists():
                    paths.append(Path(str(path) + ".pub"))
        return paths + list(Path("/etc/systemd/system").glob("exam*"))

    def check_backup(self):
        path = Path(self.record["backup"])
        assert path.parent == self.stage / "backup" and not path.is_symlink() and path.stat().st_size == self.record["backup_bytes"] and digest(path) == self.record["backup_sha256"], "Verified native recovery coverage changed"

    def install(self):
        self.web_stopped()
        assert self.record["phase"] in ("BACKED_UP", "INSTALLING", "INSTALLED")
        self.stopped()
        self.check_backup()
        self.inputs()
        for name, path in TARGETS.items():
            info = Path(path).lstat()
            assert stat.S_ISREG(info.st_mode) and info.st_uid == OWNER_UID and not info.st_mode & 0o022
            assert digest(path) in (self.update["before"]["binary_sha256"][name], self.update["after"]["binary_sha256"][name]), "Unknown partially installed binary"
        self.save("INSTALLING")
        for name, path in TARGETS.items():
            if digest(path) != self.update["after"]["binary_sha256"][name]:
                atomic(Path(path), (self.stage / "native" / name).read_bytes(), 0o755)
        self.binaries("after")
        self.save("INSTALLED")

    def start(self):
        self.web_stopped()
        assert self.record["phase"] in ("INSTALLED", "STARTING")
        self.preserved()
        self.binaries("after")
        if self.record["phase"] == "INSTALLED":
            self.stopped()
        self.save("STARTING")
        for name in START:
            command(["/usr/bin/systemctl", "start", name])
        until = time.monotonic() + 20
        while True:
            try:
                self.health()
                break
            except StartupPending:
                assert time.monotonic() < until, "Matched native roles did not become ready; remain fenced and resume the same candidate"
                time.sleep(0.1)
        self.save("RUNNING", service_pids=self.pids())

    def health(self):
        self.preserved()
        self.binaries("after")
        # Type=simple announces MainPID before exec and socket publication.
        # First obtain the existing authenticated live-role agreement, then
        # independently compare the actual loaded process identities below.
        try:
            response = json.loads(command([TARGETS["examctl"], "health"], timeout=20))
        except (AssertionError, OSError, subprocess.TimeoutExpired):
            if self.record["phase"] == "STARTING":
                raise StartupPending()
            raise
        support = response["execution_policy_support"]
        if support["supported"] is not True or response["native_roles"]["complete"] is not True:
            raise StartupPending()
        assert support["roles"] == ["agent", "watchdog", "source-worker"] and not support["issues"]
        for name in ROLES:
            value = unit(name)
            pid = int(value["MainPID"])
            if value["ActiveState"] == "activating" or (value["ActiveState"] == "active" and pid <= 1):
                raise StartupPending()
            assert value["ActiveState"] == "active" and pid > 1, "Native service failed during startup"
            expected = self.update["after"]["binary_sha256"]["examctl" if name == "exam-source-setup.service" else "exam-agent"]
            assert digest(Path("/proc") / str(pid) / "exe") == expected, "Stale loaded native role: " + name

    def files_identity(self):
        hashes = []
        ignored = {"state.json", "state.json.tmp", "audit.ndjson", "account-policy-audit.ndjson", "source-worker-policy-role.json"}
        for label, root in (("state", self.state), ("work", self.work)):
            for path in sorted(root.rglob("*")):
                info = path.lstat()
                if stat.S_ISREG(info.st_mode) and path.name not in ignored and not path.name.endswith(".lock"):
                    hashes.append((label, str(path.relative_to(root)), info.st_uid, info.st_gid, stat.S_IMODE(info.st_mode), digest(path)))
        return hashlib.sha256(canonical(hashes)).hexdigest()

    def verify(self):
        assert self.record["phase"] in ("RUNNING", "VERIFIED")
        self.health()
        assert self.files_identity() == self.record["files_sha256"], "Protected files, work or account metadata changed"
        pids = self.pids()
        assert pids == self.record["service_pids"] and pids["exam-ssh-relay.service"] == self.update["before"]["service_pids"]["exam-ssh-relay.service"]
        proof = {"nonce": self.update["nonce"], "phase": "NATIVE_MATCHED_VERIFIED", "binary_sha256": self.update["after"]["binary_sha256"], "service_pids": pids, **{k: self.release[k] for k in ("native_history_sha256", "native_config_sha256", "cli_config_sha256")}}
        proof["history_sha256"] = proof.pop("native_history_sha256")
        proof["config_sha256"] = proof.pop("native_config_sha256")
        atomic(self.stage / "native-transition.json", canonical(proof) + b"\n")
        self.save("VERIFIED")
        return proof


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--stage", type=Path, required=True)
    parser.add_argument("--fixture", action="store_true", help="Private nspawn installation qualification only")
    parser.add_argument("phase", choices=("guard-before", "stop", "backup", "install", "start", "verify", "guard-after", "status"))
    args = parser.parse_args()
    require_root()
    os.umask(0o077)
    if args.fixture:
        output = Path("/run/ssh-exam-qualification-output")
        assert Path("/run/systemd/container").read_text().strip() == "systemd-nspawn" and output.is_mount() and Path("/run/ssh-exam-qualification-input").is_mount() and args.stage.resolve().is_relative_to(output)
    if args.phase == "status":
        print(json.dumps(Native(args.stage, args.fixture).record), flush=True)
        return
    assert args.stage.is_absolute() and not any(path.is_symlink() for path in (args.stage, *args.stage.parents))
    private(args.stage, directory=True)
    descriptor = os.open(args.stage / "native-operation.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        info = os.fstat(descriptor)
        assert stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and stat.S_IMODE(info.st_mode) == 0o600 and info.st_nlink == 1
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError("Another native cutover command is still running. Inspect status; do not start a second operation.") from None
        operation = Native(args.stage, args.fixture)
        if args.phase.startswith("guard-"):
            result = operation.guard(args.phase == "guard-after")
        else:
            result = getattr(operation, args.phase)() or operation.record
        print(json.dumps(result), flush=True)
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    main()
