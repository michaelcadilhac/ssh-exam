#!/usr/bin/env python3
"""Render one self-contained exam nginx site with maintenance responses.

The default handles an unavailable gateway. --fence also blocks external page
navigation and new sign-ins/starts while preserving healthy agent/status/finish
traffic and loopback acceptance. This renders files only: it never installs,
reloads, stops a service, checks a host drain, or authorizes deployment.
"""
import argparse
from pathlib import Path
import re


FENCE_MAPS = """map $uri $ssh_exam_rollout_new_admission {
    default 0;
    / 1;
    /index.html 1;
    ~^/admin(?:/|$) 1;
    /api/admin/login 1;
    /api/auth/start 1;
    /api/auth/complete 1;
    /api/auth/dialogue 1;
    /api/browser/ssh 1;
    /api/student/preflight 1;
    ~^/api/student/attempts/[^/]+/(begin|practice)$ 1;
}
map $remote_addr $ssh_exam_rollout_external {
    default 1;
    127.0.0.1 0;
    ::1 0;
}
map "$ssh_exam_rollout_external:$ssh_exam_rollout_new_admission" $ssh_exam_rollout_refuse {
    default 0;
    "1:1" 1;
}
map $ssh_exam_rollout_refuse $ssh_exam_fence_type {
    default "";
    1 $ssh_exam_maintenance_type;
}
map $ssh_exam_rollout_refuse $ssh_exam_fence_retry {
    default "";
    1 "60";
}
map $ssh_exam_rollout_refuse $ssh_exam_fence_cache {
    default "";
    1 "no-store";
}
"""


def server_openings(source):
    """Accept the repository's two explicit server blocks; ignore quoted braces."""
    openings = list(re.finditer(r'(?m)^server\s*\{', source))
    if len(openings) != 2:
        raise ValueError('Expected exactly the HTTP and HTTPS exam server blocks; review another template explicitly')
    for match in openings:
        level = 1
        quote = None
        comment = False
        escaped = False
        for character in source[match.end():]:
            if comment:
                if character == '\n':
                    comment = False
            elif escaped:
                escaped = False
            elif character == '\\':
                escaped = True
            elif quote:
                if character == quote:
                    quote = None
            elif character in ('"', "'"):
                quote = character
            elif character == '#':
                comment = True
            elif character == '{':
                level += 1
            elif character == '}':
                level -= 1
                if not level:
                    break
        else:
            raise ValueError('Unclosed server block; no output written')
    return openings


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--site', required=True, type=Path, help='Tracked HTTP-context exam site template')
    parser.add_argument('--output', required=True, type=Path, help='New output file; existing files are never overwritten')
    parser.add_argument('--fence', action='store_true', help='Also stop external navigation and new admissions; does not drain or stop exams')
    args = parser.parse_args()
    source = args.site.read_text()
    if any(marker in source for marker in ('ssh_exam_maintenance_body', 'ssh_exam_rollout_refuse')):
        parser.error('Use the original unfenced site template, not an already-rendered candidate')
    directory = Path(__file__).resolve().parents[1]/'deploy/nginx'
    maps = (directory/'maintenance-maps.conf').read_text()
    response = (directory/'maintenance-response.conf').read_text()
    insert = '\n'
    if args.fence:
        insert += ('    default_type "";\n'
                   '    add_header Content-Type $ssh_exam_fence_type always;\n'
                   '    add_header Retry-After $ssh_exam_fence_retry always;\n'
                   '    add_header Cache-Control $ssh_exam_fence_cache always;\n'
                   '    if ($ssh_exam_rollout_refuse) { return 503 $ssh_exam_maintenance_body; }\n')
    insert += ''.join('    '+line+'\n' for line in response.splitlines())
    try:
        openings = server_openings(source)
    except ValueError as error:
        parser.error(str(error))
    for match in reversed(openings):
        source = source[:match.end()] + insert + source[match.end():]
    rendered = '# Generated by scripts/render-rollout-nginx; validate before installation.\n'+maps+'\n'
    if args.fence:
        rendered += FENCE_MAPS+'\n'
    rendered += source
    with args.output.open('x') as stream:
        stream.write(rendered)
    print(str(args.output))


if __name__ == '__main__':
    main()
