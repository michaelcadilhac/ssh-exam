#!/usr/bin/env python3
"""Consistent offline backup. Stop/drain the gateway first; never copy a live SQLite WAL."""
import argparse, os, sqlite3, shutil, pathlib
p=argparse.ArgumentParser();p.add_argument('data');p.add_argument('destination');p.add_argument('--gateway-stopped',action='store_true',required=True);a=p.parse_args()
src=pathlib.Path(a.data).resolve();dest=pathlib.Path(a.destination).resolve()
if dest.exists() or src==dest or src in dest.parents: raise SystemExit('Destination must be new and outside data')
dest.mkdir(mode=0o700,parents=True)
with sqlite3.connect(src/'metadata.sqlite') as original,sqlite3.connect(dest/'metadata.sqlite') as output:original.backup(output)
for name in ('receipts','monitoring','submissions'):
 if (src/name).exists():shutil.copytree(src/name,dest/name)
os.chmod(dest/'metadata.sqlite',0o600)
print('Backup complete. Keep latest deletion tombstones separately; expire monitoring backups within 60 days.')
