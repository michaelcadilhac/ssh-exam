;;; terminal-clipboard-tests.el --- Terminal clipboard regressions -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'term/xterm)
(defconst depaul-clipboard-test-directory (file-name-directory load-file-name))
(load (expand-file-name "50terminal-clipboard.el" depaul-clipboard-test-directory) nil t)

(ert-deftest depaul-clipboard-copy-only-tty ()
  (let ((depaul-terminal-clipboard-enabled t)
        (capabilities xterm-extra-capabilities)
        (cut interprogram-cut-function)
        (paste interprogram-paste-function))
    (set-terminal-parameter nil 'xterm--set-selection nil)
    (set-terminal-parameter nil 'xterm--get-selection nil)
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _frame) nil)))
      (depaul-terminal-clipboard-setup))
    (should (eq t (terminal-parameter nil 'xterm--set-selection)))
    (should-not (terminal-parameter nil 'xterm--get-selection))
    (should (equal capabilities xterm-extra-capabilities))
    (should (eq cut interprogram-cut-function))
    (should (eq paste interprogram-paste-function))
    (should (eq (lookup-key global-map (kbd "C-w")) 'kill-region))
    (should (eq (lookup-key global-map (kbd "M-w")) 'kill-ring-save))))

(ert-deftest depaul-clipboard-respects-gui-and-opt-out ()
  (dolist (graphic '(nil t))
    (let ((depaul-terminal-clipboard-enabled graphic))
      ;; First disabled on a tty, then enabled in a GUI frame.
      (set-terminal-parameter nil 'xterm--set-selection nil)
      (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _frame) graphic)))
        (depaul-terminal-clipboard-setup))
      (should-not (terminal-parameter nil 'xterm--set-selection)))))

(ert-deftest depaul-clipboard-hook-reload-is-idempotent ()
  (load (expand-file-name "50terminal-clipboard.el" depaul-clipboard-test-directory) nil t)
  (should (= 1 (cl-count #'depaul-terminal-clipboard-setup terminal-init-xterm-hook))))
