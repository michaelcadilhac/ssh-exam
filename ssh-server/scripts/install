#!/bin/sh
set -eu
[ "$(id -u)" = 0 ] || { echo 'Run as root on a disposable/approved class server'; exit 1; }
cd "$(dirname "$0")/.."
case "${1:-}" in
  "") build=true ;;
  --prebuilt) build=false ;;
  *) echo 'Usage: scripts/install [--prebuilt]'; exit 1 ;;
esac
command -v bwrap >/dev/null
[ -f /sys/fs/cgroup/cgroup.controllers ]
mkdir -p bin
if [ "$build" = true ]; then
  command -v go >/dev/null
  for name in exam-agent exam-login examctl exam-info; do CGO_ENABLED=0 go build -trimpath -o "bin/$name" "./cmd/$name"; done
else
  [ "$(uname -m)" = x86_64 ] || { echo 'Prebuilt test bundle requires Linux x86_64; build from source on other architectures'; exit 1; }
  [ -f bin/SHA256SUMS ] || { echo 'Prebuilt checksum manifest missing'; exit 1; }
  sha256sum -c bin/SHA256SUMS
  for name in exam-agent exam-login examctl exam-info; do [ -x "bin/$name" ]; done
fi
install -d -m 0700 /etc/exam-agent /var/lib/exam-agent
install -d -m 0755 /usr/local/libexec /srv/exam-workspace/work
install -o root -g root -m 0755 bin/exam-login /usr/local/libexec/exam-login
install -o root -g root -m 0755 scripts/exam-control /usr/local/bin/exam-control
install -o root -g root -m 0755 scripts/account-policy /usr/local/sbin/exam-account-policy
install -o root -g root -m 0755 scripts/check-isolation /usr/local/sbin/exam-check-isolation
install -o root -g root -m 0755 bin/exam-info /usr/local/bin/exam-info
install -o root -g root -m 0755 bin/exam-agent bin/examctl /usr/local/sbin/
install -o root -g root -m 0644 systemd/* /etc/systemd/system/
if [ ! -f /etc/exam-agent/agent.json ]; then install -m 0600 config/agent.example.json /etc/exam-agent/agent.json; fi
if [ ! -f /etc/exam-agent/guards.json ]; then install -m 0600 config/guards.example.json /etc/exam-agent/guards.json; fi
groupadd -f exam-managed
if ! grep -qxF '/usr/local/libexec/exam-login' /etc/shells; then echo /usr/local/libexec/exam-login >> /etc/shells; fi
systemctl daemon-reload
printf '%s\n' 'Binaries installed. Configure gateway signatures, HTTPS callbacks, rootfs, allowlist, SSH/PAM and verify before enabling services or enrolling accounts.'
