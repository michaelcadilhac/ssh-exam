#!/usr/bin/env python3
"""Root approval of existing accounts. CSV import never calls this program."""
import sys,os,pwd,grp,json,pathlib,subprocess,re
if os.geteuid()!=0:raise SystemExit('Root approval required')
p=pathlib.Path('/etc/exam-agent/agent.json');c=json.loads(p.read_text());seen=set()
if c.get('temporary_account_policy'):raise SystemExit('Permanent enrollment is disabled: enroll students in the webapp; temporary policy is applied only at exam start')
for name in sys.argv[1:]:
 if not re.fullmatch(r'[a-z][a-z0-9_-]{0,31}',name):raise SystemExit('Invalid username')
 a=pwd.getpwnam(name);groups={grp.getgrgid(g).gr_name for g in os.getgrouplist(name,a.pw_gid)}
 if a.pw_uid<1000 or a.pw_uid in seen or groups & {'root','sudo','wheel','docker','lxd','adm','libvirt','disk'}:raise SystemExit('Privileged or duplicate account rejected')
 if pathlib.Path('/usr/bin/sudo').exists():
  rights=subprocess.run(['/usr/bin/sudo','-n','-l','-U',name],capture_output=True,text=True,timeout=15,env={**os.environ,'LC_ALL':'C'})
  denied=re.compile(r'User '+re.escape(name)+r' is not allowed to run sudo on [^\n]+\.')
  if rights.returncode not in [0,1] or not any(denied.fullmatch(line.strip()) for line in (rights.stdout+'\n'+rights.stderr).splitlines()):raise SystemExit('Sudo-authorized account or unverifiable permissions rejected; use an unprivileged identity with separate administrator recovery access')
 seen.add(a.pw_uid)
 if name in c['accounts'] and a.pw_shell=='/usr/local/libexec/exam-login':continue
 if a.pw_shell not in ['/bin/bash','/bin/zsh','/bin/sh']:raise SystemExit('Unsupported original shell')
 c['accounts'][name]={'uid':a.pw_uid,'gid':a.pw_gid,'home':a.pw_dir,'shell':a.pw_shell}
 # Save original mapping BEFORE changing the account. Preserve this root-owned backup.
 tmp=p.with_suffix('.tmp');tmp.write_text(json.dumps(c,indent=2));os.chmod(tmp,0o600);os.replace(tmp,p)
 subprocess.run(['usermod','-a','-G','exam-managed',name],check=True)
 subprocess.run(['loginctl','disable-linger',name],check=True)
 subprocess.run(['usermod','-s','/usr/local/libexec/exam-login',name],check=True)
 print('Approved and gated',name)
