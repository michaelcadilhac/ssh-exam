#!/usr/bin/env python3
"""Install the reviewed Ubuntu/Debian managed-account policy, preserving other users.
Run only with an independent administrator recovery session. Does not enroll users.
"""
import argparse, grp, os, pathlib, pwd, re, shutil, subprocess, time
p=argparse.ArgumentParser(description=__doc__);p.add_argument('--apply',action='store_true');p.add_argument('--administrator',required=True);a=p.parse_args()
assert os.geteuid()==0,'Root required'
admin=pwd.getpwnam(a.administrator)
assert 'exam-managed' not in {grp.getgrgid(g).gr_name for g in os.getgrouplist(a.administrator,admin.pw_gid)},'Administrator must remain outside exam-managed'
assert admin.pw_shell in ['/bin/bash','/bin/zsh','/bin/sh'],'Preserve a normal administrator shell'
assert pathlib.Path('/etc/pam.d/common-session').exists(),'Reviewed Debian/Ubuntu PAM structure required'
patches={}
common=pathlib.Path('/etc/pam.d/common-session');text=common.read_text();guard='session [success=1 default=ignore] pam_succeed_if.so user ingroup exam-managed\n'
if guard not in text:
 matches=list(re.finditer(r'^session\s+optional\s+pam_systemd\.so\s*$',text,re.M));assert len(matches)==1,'Expected exactly one pam_systemd module'
 m=matches[0];text=text[:m.start()]+guard+text[m.start():];patches[common]=text
rule='account requisite pam_succeed_if.so user notingroup exam-managed\n'
for name in ['login','su','su-l','runuser','runuser-l','cron','atd','samba','other','sudo','sudo-i','vmtoolsd']:
 file=pathlib.Path('/etc/pam.d',name)
 if file.exists():
  text=file.read_text()
  if not text.startswith(rule):patches[file]=rule+text
file=pathlib.Path('/etc/pam.d/chsh');text=file.read_text();deny='auth requisite pam_succeed_if.so user notingroup exam-managed\n'
if not text.startswith(deny):patches[file]=deny+text
# Keep administrator pam_env behavior; managed users cannot supply startup environment.
file=pathlib.Path('/etc/pam.d/sshd');text=file.read_text()
for match in list(re.finditer(r'^session\s+required\s+pam_env\.so\s+[^\n]*user_readenv=1[^\n]*$',text,re.M))[::-1]:
 original=match[0]
 safe=original.replace('user_readenv=1','user_readenv=0')
 replacement=guard+original+'\nsession [success=1 default=ignore] pam_succeed_if.so user notingroup exam-managed\n'+safe
 if replacement in text:continue
 text=text[:match.start()]+replacement+text[match.end():]
if text!=file.read_text():patches[file]=text
file=pathlib.Path('/etc/ssh/sshd_config.d/60-exam.conf')
source=pathlib.Path(__file__).resolve().parent.parent/'config/sshd-exam.example.conf'
text=source.read_text()
if not file.exists() or file.read_text()!=text:patches[file]=text
print('Policy files:',*[str(p) for p in patches],sep='\n')
if not a.apply:print('Review complete; --apply installs and backs up this exact policy');raise SystemExit
backup=pathlib.Path('/var/backups/ssh-exam')/time.strftime('%Y%m%dT%H%M%SZ-account-policy',time.gmtime());backup.mkdir(mode=0o700,parents=True)
try:
 for file,text in patches.items():
  if file.exists():shutil.copy2(file,backup/(str(file).lstrip('/').replace('/','__')))
  file.parent.mkdir(exist_ok=True);temp=file.with_suffix(file.suffix+'.exam-new');temp.write_text(text);temp.chmod(0o644);os.chown(temp,0,0);os.replace(temp,file)
 subprocess.run(['/usr/sbin/sshd','-t'],check=True)
 result=subprocess.run(['/usr/sbin/sshd','-T','-C',f'user={a.administrator},host=class.example.edu,addr=127.0.0.1'],capture_output=True,text=True,check=True)
 assert 'forcecommand none\n' in result.stdout,'Administrator unexpectedly matched exam gate'
 subprocess.run(['systemctl','reload','ssh.service'],check=True)
except BaseException:
 for file in patches:
  original=backup/(str(file).lstrip('/').replace('/','__'))
  if original.exists():shutil.copy2(original,file)
  else:file.unlink(missing_ok=True)
 subprocess.run(['/usr/sbin/sshd','-t'],check=False)
 raise
print('Installed managed-account policy; administrator shell/group/access preserved. Backup:',backup)
