#!/usr/bin/env python3
"""Authorize only an unconsumed, short-lived exam handoff certificate. No passwords."""
import json,os,pathlib,re,stat,sys,time

def protected(path):
    s=path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid!=0 or s.st_mode&0o077:
        raise ValueError('Unprotected SSH handoff state')
    return json.loads(path.read_text())

def principal(config,state,user,keyid,encoded,now,boot,load_journal):
    if not config.get('temporary_account_policy') or not re.fullmatch(r'[a-f0-9]{64}',keyid) or len(encoded)>8192:
        return None
    for a in state.get('attempts',{}).values():
        h=a.get('ssh_handoff') or {}
        if a['username']!=user or h.get('id')!=keyid: continue
        if (a['state']!='PREPARING' or a.get('start') or a.get('deadline') or a.get('original_deadline') or
            a.get('policy_state')!='READY' or a.get('policy_ready_boot')!=boot or
            a.get('policy_expires',0)<=now or h.get('expires',0)<=now or h.get('consumed') or
            h.get('certificate_key')!=encoded): return None
        j=load_journal(a['uid'])
        if j.get('phase')!='READY' or j.get('attempt')!=a['id'] or j.get('generation')!=a.get('policy_generation'):return None
        expected='exam:'+a['id']+':'+a['policy_generation']
        return expected if h.get('principal')==expected else None
    return None

if __name__=='__main__':
    try:
        if os.geteuid()!=0 or len(sys.argv)!=4:raise ValueError('Root SSH helper only')
        c=protected(pathlib.Path('/etc/exam-agent/agent.json'));root=pathlib.Path(c['state'])
        p=principal(c,protected(root/'state.json'),*sys.argv[1:],int(time.time()*1000),pathlib.Path('/proc/sys/kernel/random/boot_id').read_text().strip(),lambda uid:protected(root/'account-policy'/(str(uid)+'.json')))
        if not p:raise ValueError('Certificate not authorized')
        print(p)
    except Exception:sys.exit(1)
