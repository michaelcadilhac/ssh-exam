{
  "name": "ssh-exam-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build:clock": "node scripts/build-monitoring-clock.cjs",
    "predev": "npm run build:clock",
    "dev": "tsx apps/server/src/main.ts",
    "build": "npm run build:clock && node scripts/build-browser-ssh.cjs && vite build --config apps/web/vite.config.ts && tsc -p tsconfig.server.json",
    "start": "node dist/apps/server/src/main.js",
    "pretest": "npm run build:clock",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "fixtures": "tsx tests/fixtures/ssh-hosts.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "doctor": "tsx scripts/doctor.ts",
    "postinstall": "node scripts/patch-ssh2.cjs",
    "format": "prettier --write apps packages scripts tests *.ts *.json compose.yaml",
    "test:load": "tsx tests/load.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.6",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "argon2": "0.44.0",
    "better-sqlite3": "12.11.1",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.6.0",
    "fastify": "5.12.5",
    "nodemailer": "10.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5",
    "ssh2": "1.17.0",
    "winbox": "0.2.82",
    "ws": "8.22.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/ssh2": "1.15.5",
    "@types/ws": "8.18.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "argon2@0.44.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.4": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "sharp@0.35.5": true
  }
}
